# ComfyUI (SDXL images + LTX video) with PyTorch. GPU comes from the host driver
# injected by the NVIDIA Container Toolkit; the CUDA/cuDNN userspace ships inside
# the torch wheels (nvidia-*-cu13), so no CUDA base image is needed — matching how
# it runs on the host (see yt-agent-context.md §Session 3). Build on the target arch
# so pip picks the right wheel (aarch64 sbsa on Jetson / x86_64 on cloud).
FROM python:3.12-slim-bookworm

ARG TORCH_INDEX=https://download.pytorch.org/whl/cu130

RUN apt-get update && apt-get install -y --no-install-recommends \
        git ca-certificates libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt
RUN git clone --depth 1 https://github.com/comfyanonymous/ComfyUI.git comfyui
WORKDIR /opt/comfyui

# torch first (prebuilt CUDA 13 wheel), then ComfyUI's own requirements
RUN pip install --no-cache-dir --pre torch torchvision --index-url ${TORCH_INDEX} \
 && pip install --no-cache-dir -r requirements.txt

# point ComfyUI at the NVMe-mounted models
COPY extra_model_paths.yaml /opt/comfyui/extra_model_paths.yaml

EXPOSE 8188
# listen on all interfaces (compose network); write gens to the shared NVMe output
CMD ["python", "main.py", "--listen", "0.0.0.0", "--port", "8188", \
     "--output-directory", "/mnt/nvme/yt-agent/output"]
