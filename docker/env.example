# Copy to .env  (cp env.example .env)  and adjust. docker compose reads .env automatically.

# Host directory holding models + outputs (mounted into app + comfyui at the same path).
# Must contain comfyui-models/ (checkpoints, text_encoders, ...) and will receive output/.
NVME_ROOT=/mnt/nvme/yt-agent

# Where Ollama stores pulled models. Default = a named docker volume (re-pull needed).
# To REUSE the host's already-pulled models instead (avoids a ~9GB re-download),
# set this to the host ollama dir, e.g.:
#   OLLAMA_MODELS=/usr/share/ollama/.ollama
# (leave as the volume name to keep them inside docker)
OLLAMA_MODELS=ollama_models

# PyTorch wheel index for ComfyUI. cu130 = CUDA 13 (JetPack 7 / recent cloud).
# For other CUDA versions use e.g. https://download.pytorch.org/whl/cu124
TORCH_INDEX=https://download.pytorch.org/whl/cu130
